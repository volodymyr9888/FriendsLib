<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.friendslib.BooksViewController">
    <Label text="All Books" style="-fx-font-size: 18px;"/>
    <TableView fx:id="booksTable" prefWidth="400">
        <columns>
            <TableColumn text="Title" fx:id="titleColumn" />
            <TableColumn text="Author" fx:id="authorColumn" />
            <TableColumn text="Owner" fx:id="ownerColumn" />
            <TableColumn text="Action" fx:id="actionColumn" />
        </columns>
    </TableView>
</VBox>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.friendslib.BooksViewController">
    <Label text="All Books" style="-fx-font-size: 18px;"/>
    <TableView fx:id="booksTable" prefWidth="400">
        <columns>
            <TableColumn fx:id="bookIdColumn" text="Book ID" />
            <TableColumn fx:id="titleColumn" text="Title" />
            <TableColumn fx:id="authorColumn" text="Author" />
            <TableColumn fx:id="ownerColumn" text="Owner" />
        </columns>
    </TableView>
</VBox>